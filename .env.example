# The API loads repository .env; process variables take precedence, without interpolation.
# Set false to ignore local .env (tests do this automatically).
AEGISGRAPH_LOAD_ENV=true
# These are public local-only demo database credentials, never production secrets.
DATABASE_URL=postgresql+psycopg://aegisgraph:demo-local-only@127.0.0.1:5432/aegisgraph
AI_PROVIDER=deterministic
# Required only for AI_PROVIDER=openai. Supply privately in ignored .env or process environment.
OPENAI_API_KEY=
OPENAI_MODEL=
# Next.js server proxy target; never exposed as a browser credential.
API_INTERNAL_URL=http://127.0.0.1:8000
DEMO_ANALYST=demo.analyst
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Keep the local-client restriction. This switch does not provide authentication.
ALLOW_REMOTE_DEMO=false
